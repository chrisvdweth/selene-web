---
import BaseLayout from "../layouts/BaseLayout.astro";
import csv from "../data/prerequisites.csv?raw";
import learningPaths from "../data/learning-paths.json?raw";
import health from "../data/notebook-health.json";
import { EDGE_COUNT, topics } from "../lib/topics";

const rowCount = csv.trim().split(/\r?\n/).length - 1;
---

<BaseLayout title="Admin · SELENE" description="Review source health and export SELENE learning-path specifications.">
  <section class="page-head">
    <h1>SELENE administration</h1>
    <p class="lead">
      Review the checked source snapshot and export edited specifications for review and publication.
    </p>
  </section>

  <section class="editor" aria-labelledby="health-heading">
    <div>
      <h2 id="health-heading">Source health</h2>
      <p class="field-hint">Notebook structure and formatting checked at commit <code>{health.commit}</code>.</p>
      <div class="readout">
        <div><b>{health.summary.passed}</b><span>passed</span></div>
        <div><b>{health.summary.warning}</b><span>with warnings</span></div>
        <div><b>{health.summary.failed}</b><span>failed</span></div>
      </div>
      {health.summary.failed > 0 && <ul>{health.files.filter((file) => file.status === "failed").map((file) => <li><code>{file.notebook}</code>: {file.errors.join("; ")}</li>)}</ul>}
    </div>
  </section>

  <div class="readout">
    <div><b>{rowCount}</b><span>rows in the file</span></div>
    <div><b>{EDGE_COUNT}</b><span>links in use</span></div>
    <div><b>{topics.length}</b><span>topics available as endpoints</span></div>
  </div>

  <div class="editor">
    <div>
      <label class="rule-label" for="csv">prerequisites.csv</label>
      <p class="field-hint" id="csv-hint">
        One directed link per line: <code>source,target,relationship</code>. The source has to be finished before the
        target. Use topic IDs exactly as they appear in <code>src/data/topics.csv</code>. Long lines scroll sideways
        rather than wrapping, so one record always stays one line.
      </p>
      <textarea id="csv" rows="10" wrap="off" spellcheck="false" aria-describedby="csv-hint">{csv}</textarea>
      <div class="actions">
        <button class="button-primary" id="download" type="button">Download prerequisites.csv</button>
        <p class="editor-status" id="editor-status" role="status"></p>
      </div>
    </div>

    <aside class="editor-notes" aria-labelledby="workflow-heading">
      <p class="rule-label" id="workflow-heading">The round trip</p>
      <ol>
        <li>Add or remove lines above. Only the textarea changes; the published map is untouched.</li>
        <li>Download the file. It replaces <code>src/data/prerequisites.csv</code> in the repository.</li>
        <li>Commit it. Topics and every dependency view read from that file on the next build.</li>
      </ol>
      <p class="field-hint">
        A link only appears in the diagrams once the topic's <code>prerequisites</code> column in
        <code>topics.csv</code> agrees with it, which is why most of the corpus still shows no path.
      </p>
    </aside>
  </div>

  <div class="editor">
    <div>
      <label class="rule-label" for="learning-paths">learning-paths.json</label>
      <p class="field-hint" id="learning-paths-hint">Edit path titles, stages, and lesson IDs, then export the file for review.</p>
      <textarea id="learning-paths" rows="16" wrap="off" spellcheck="false" aria-describedby="learning-paths-hint">{learningPaths}</textarea>
      <div class="actions"><button class="button-primary" id="download-learning-paths" type="button">Download learning-paths.json</button><p class="editor-status" id="learning-paths-status" role="status"></p></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const field = document.querySelector("#csv");
      const status = document.querySelector("#editor-status");

      document.querySelector("#download")?.addEventListener("click", () => {
        const text = field.value;
        const rows = text.trim().split(/\r?\n/).length - 1;
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([text], { type: "text/csv" }));
        link.download = "prerequisites.csv";
        link.click();
        URL.revokeObjectURL(link.href);
        status.textContent = `Exported ${rows} link${rows === 1 ? "" : "s"}.`;
      });
      document.querySelector("#download-learning-paths")?.addEventListener("click", () => {
        const field = document.querySelector("#learning-paths");
        const status = document.querySelector("#learning-paths-status");
        try { JSON.parse(field.value); } catch { status.textContent = "The learning path specification is not valid JSON."; return; }
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([field.value], { type: "application/json" }));
        link.download = "learning-paths.json";
        link.click();
        URL.revokeObjectURL(link.href);
        status.textContent = "Exported learning-paths.json.";
      });
    })();
  </script>
</BaseLayout>
