---
import BaseLayout from "../layouts/BaseLayout.astro";
import LearningPaths from "../components/LearningPaths";
import Workbench from "../components/Workbench";
---

<BaseLayout title="SELENE · Learn AI from notebooks">
  <section class="page-head hero">
    <h1>Choose a learner path and build your knowledge.</h1>
    <p class="lead">Read the notebook, run the standalone version in Colab, and keep track of what you have completed on this device.</p>
  </section>

  <LearningPaths switcher client:load />
  <section class="home-topic-browser" aria-labelledby="browse-topics-heading">
    <div class="page-head">
      <h2 id="browse-topics-heading">Explore individual topics</h2>
      <p class="lead">Find a notebook and explore how its prerequisites connect.</p>
    </div>
    <Workbench client:load rememberSelection />
  </section>
</BaseLayout>
