---
import BaseLayout from "../layouts/BaseLayout.astro";
import Workbench from "../components/Workbench";
import { topics, unlockedBy } from "../lib/topics";

/* Open on a mapped topic so the topic browser demonstrates a path rather than an
   empty state on first load. */
const opening = topics.find((t) => t.prerequisites.length > 0 || unlockedBy(t.id).length > 0)?.id;
---

<BaseLayout title="SELENE · Learn AI from notebooks">
  <section class="page-head hero">
    <h1>Choose a topic and work through its prerequisites.</h1>
    <p class="lead">Read the notebook, run the standalone version in Colab, and keep track of what you have completed on this device.</p>
  </section>

  <Workbench client:load initialId={opening} />
</BaseLayout>
