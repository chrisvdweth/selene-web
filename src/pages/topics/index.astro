---
import CompletionMark from "../../components/CompletionMark";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SearchIcon } from "../../components/Icon";
import { CATEGORIES, categoryKey, topics, unlockedBy } from "../../lib/topics";

const groups = CATEGORIES.map((category) => ({
  category,
  key: categoryKey(category),
  items: topics.filter((t) => t.category === category).sort((a, b) => a.title.localeCompare(b.title)),
}));

/* Levels in teaching order, not alphabetical. */
const LEVELS = ["Beginner", "Intermediate", "Advanced"].filter((level) => topics.some((t) => t.difficulty === level));

/* A notebook is "on a path" if a prerequisite links it to anything, either way. */
const mapped = (id: string) => (topics.find((t) => t.id === id)?.prerequisites.length ?? 0) > 0 || unlockedBy(id).length > 0;

/* `all` is the unfiltered option's wording, which doubles as the closed
   dropdown's label — so it has to name the facet, not just say "All". */
const filters: { name: string; label: string; all: string; options: string[] }[] = [
  { name: "category", label: "Limit to a category", all: "All categories", options: CATEGORIES },
  { name: "level", label: "Limit to a level", all: "All levels", options: LEVELS },
  { name: "path", label: "Limit by path", all: "Mapped and unmapped", options: ["On a path", "Not yet mapped"] },
];
---

<BaseLayout title="Notebooks · SELENE" description="Every indexed SELENE notebook, grouped by category.">
  <section class="page-head">
    <h1>Every notebook on the shelf</h1>
  </section>

  <div class="index-bar">
    <label class="field">
      <SearchIcon />
      <span class="sr-only">Search notebooks by name, subject or level</span>
      <input
        type="search"
        id="index-filter"
        placeholder="Search notebooks"
        autocomplete="off"
        aria-describedby="index-count"
      />
    </label>
    {
      filters.map((filter) => (
        <label class="select">
          <span class="sr-only">{filter.label}</span>
          <select data-filter={filter.name}>
            <option value="">{filter.all}</option>
            {filter.options.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </label>
      ))
    }
  </div>

  {
    groups.map((group) => (
      <section class="index-section" data-group>
        <h2>
          <span class={`cat-swatch cat-${group.key}`} aria-hidden="true"></span>
          {group.category}
          <span class="data" data-group-count>
            {group.items.length}
          </span>
        </h2>
        <ul class="index-table">
          {group.items.map((topic) => (
            <li
              data-row
              data-search={`${topic.title} ${topic.subtopic} ${topic.difficulty} ${topic.notebook}`.toLowerCase()}
              data-category={topic.category}
              data-level={topic.difficulty}
              data-path={mapped(topic.id) ? "On a path" : "Not yet mapped"}
            >
              <a class="index-row" href={`/topics/${topic.id}`}>
                <span>
                  <strong>{topic.title}<CompletionMark topicId={topic.id} /></strong>
                  <span class="row-sub">{topic.subtopic}</span>
                </span>
                <span class="row-sub">{topic.difficulty}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="index-empty" id="index-empty" hidden>
    <h2>No notebook matches that</h2>
    <p>Try a shorter word, or widen the filters above.</p>
    <div class="actions">
      <button class="button-ghost" id="index-reset" type="button">Clear search and filters</button>
    </div>
  </section>

  <nav class="index-pagination" id="index-pagination" aria-label="Notebook pages" hidden>
    <label class="index-page-size">
      <span>Entries per page</span>
      <span class="select">
        <select id="index-page-size">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="all">All</option>
        </select>
      </span>
    </label>
    <p class="data" id="index-count" role="status">Showing {topics.length ? 1 : 0}–{topics.length} of {topics.length} entries</p>
    <div class="index-page-controls">
      <button class="button-ghost" id="index-previous" type="button">Previous</button>
      <span class="data" id="index-page"></span>
      <button class="button-ghost" id="index-next" type="button">Next</button>
    </div>
  </nav>

  <script>
    import { completedTopics } from "../../lib/device-progress";
    const syncCompletion = () => {
      const completed = completedTopics();
      document.querySelectorAll<HTMLElement>("[data-topic-completion]").forEach((mark) => {
        mark.hidden = !completed.has(mark.dataset.topicCompletion!);
      });
    };
    syncCompletion();
    window.addEventListener("selene-progress-change", syncCompletion);
    window.addEventListener("storage", syncCompletion);
    window.addEventListener("pageshow", syncCompletion);
  </script>

  <script is:inline>
    (() => {
      const input = document.querySelector("#index-filter");
      const count = document.querySelector("#index-count");
      const empty = document.querySelector("#index-empty");
      const reset = document.querySelector("#index-reset");
      const sections = [...document.querySelectorAll("[data-group]")];
      const rows = [...document.querySelectorAll("[data-row]")];
      const selects = [...document.querySelectorAll("select[data-filter]")];
      const pagination = document.querySelector("#index-pagination");
      const previous = document.querySelector("#index-previous");
      const next = document.querySelector("#index-next");
      const pageLabel = document.querySelector("#index-page");
      const pageSizeSelect = document.querySelector("#index-page-size");
      let page = 1;

      const apply = () => {
        const needle = input.value.trim().toLowerCase();
        const matches = rows.filter((row) =>
            (!needle || row.dataset.search.includes(needle)) &&
            /* An empty value is the facet's "all" option. */
            selects.every((select) => !select.value || row.dataset[select.dataset.filter] === select.value)
        );
        const total = matches.length;
        const pageSize = pageSizeSelect.value === "all" ? Math.max(1, total) : Number(pageSizeSelect.value);
        const pageCount = Math.max(1, Math.ceil(total / pageSize));
        page = Math.min(page, pageCount);
        const start = (page - 1) * pageSize;
        const visibleRows = new Set(matches.slice(start, start + pageSize));
        for (const row of rows) row.hidden = !visibleRows.has(row);

        for (const section of sections) {
          const visible = [...section.querySelectorAll("[data-row]")].filter((row) => !row.hidden).length;
          section.hidden = visible === 0;
          const label = section.querySelector("[data-group-count]");
          if (label) label.textContent = String(visible);
        }

        count.textContent = `Showing ${total ? start + 1 : 0}–${Math.min(start + pageSize, total)} of ${total} entries`;
        empty.hidden = total !== 0;
        pagination.hidden = false;
        previous.disabled = page === 1;
        next.disabled = page === pageCount;
        pageLabel.textContent = `Page ${page} of ${pageCount}`;
      };

      const applyFilters = () => {
        page = 1;
        apply();
      };
      for (const select of selects) select.addEventListener("change", applyFilters);
      pageSizeSelect.addEventListener("change", applyFilters);
      previous.addEventListener("click", () => {
        page = Math.max(1, page - 1);
        apply();
      });
      next.addEventListener("click", () => {
        page += 1;
        apply();
      });

      reset?.addEventListener("click", () => {
        input.value = "";
        for (const select of selects) select.value = "";
        applyFilters();
        input.focus();
      });

      input.addEventListener("input", applyFilters);
      apply();
    })();
  </script>
</BaseLayout>
